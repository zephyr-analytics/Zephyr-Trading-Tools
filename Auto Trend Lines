//@version=6
// Auto Trendlines + Trend Table
// Draws a declining trendline (connecting lower highs) and an upward trendline
// (connecting higher lows). Each line is the most recent one that price has not
// closed through between its two anchor points. Solid = intact, dotted = price
// has since closed through it.
// Solid horizontal lines mark the 52-week high and 52-week low (from weekly bars, so the same
// levels on any chart timeframe; the current week counts as one of the 52).
// The trend table (daily bars, so the same on any chart timeframe):
//   Trend      : linear regression of the daily close over the last 21 days
//   200 EMA    : the daily 200 EMA and price vs it
//   Structure  : the slope of the 200 EMA over the last 21 days (linear regression)
//   Trendlines : Intact / Broken, or "Not Set" when the line's latest anchor is older than 126 days
// Its position is adjustable.
indicator("Auto Trendlines", shorttitle = "Trendlines", overlay = true,
     max_lines_count = 10, max_bars_back = 5000)

// ── Inputs ────────────────────────────────────────────────────────────────
grpT = "Trendlines"
showDown   = input.bool(true, "Declining trendline (lower highs)", group = grpT)
showUp     = input.bool(true, "Upward trendline (higher lows)", group = grpT)
tlLeft     = input.int(5, "Pivot left bars",  minval = 1, group = grpT)
tlRight    = input.int(5, "Pivot right bars", minval = 1, group = grpT,
     tooltip = "Bars on each side needed to confirm a swing. Higher = bigger swings, longer-term lines.")
showBroken = input.bool(true, "Keep showing a line after price breaks it (dotted)", group = grpT)
setDays    = input.int(126, "Line counts as set if anchored within (days)", minval = 1, group = grpT,
     tooltip = "If a trendline's most recent anchor is older than this many calendar days, the table shows Not Set.")
tlWidth    = input.int(2, "Line width", minval = 1, maxval = 5, group = grpT)
dnColor    = input.color(color.new(#f5a524, 0), "Declining trendline color", group = grpT)
upColor    = input.color(color.new(#3e8ef7, 0), "Upward trendline color", group = grpT)

grp52 = "52-week high / low"
show52     = input.bool(true, "Show 52-week high / low lines", group = grp52)
show52Lbl  = input.bool(true, "Price labels", group = grp52)
w52        = input.int(2, "Line width", minval = 1, maxval = 5, group = grp52)
hi52Color  = input.color(color.new(#30a46c, 0), "52-week high color", group = grp52)
lo52Color  = input.color(color.new(#e5484d, 0), "52-week low color", group = grp52)

grpTb = "Trend table"
showPanel  = input.bool(true, "Show trend table", group = grpTb)
panelPos   = input.string("Top right", "Position", group = grpTb,
     options = ["Top left", "Top center", "Top right", "Middle left", "Middle center", "Middle right",
                "Bottom left", "Bottom center", "Bottom right"])
panelSize  = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal", "Large"], group = grpTb)
regLen     = input.int(21, "Trend: linear regression length (days)", minval = 2, group = grpTb,
     tooltip = "Least-squares line through the last N daily closes. Its rise or fall over the window sets the trend.")
flatPct    = input.float(0.0, "Flat band (%)", minval = 0, step = 0.25, group = grpTb,
     tooltip = "If the regression line moves less than this % over the window, the trend reads Flat. 0 = always Up or Down.")
emaLen     = input.int(200, "EMA length (days)", minval = 2, group = grpTb)
structLen  = input.int(21, "Structure: EMA slope window (days)", minval = 2, group = grpTb,
     tooltip = "Linear-regression slope of the EMA over this many days sets the structure.")
structFlat = input.float(0.0, "Structure flat band (%)", minval = 0, step = 0.1, group = grpTb)
bullColor  = input.color(color.new(#30a46c, 0), "Up color",   group = grpTb)
bearColor  = input.color(color.new(#e5484d, 0), "Down color", group = grpTb)

tablePos = switch panelPos
    "Top left"      => position.top_left
    "Top center"    => position.top_center
    "Top right"     => position.top_right
    "Middle left"   => position.middle_left
    "Middle center" => position.middle_center
    "Middle right"  => position.middle_right
    "Bottom left"   => position.bottom_left
    "Bottom center" => position.bottom_center
    => position.bottom_right

txtSize = switch panelSize
    "Tiny"   => size.tiny
    "Normal" => size.normal
    "Large"  => size.large
    => size.small

// ── Pivot collection ──────────────────────────────────────────────────────
tph = ta.pivothigh(high, tlLeft, tlRight)
tpl = ta.pivotlow(low, tlLeft, tlRight)

var array<float> hiP = array.new<float>()
var array<int>   hiB = array.new<int>()
var array<float> loP = array.new<float>()
var array<int>   loB = array.new<int>()
MAX_PIVOTS = 20

if not na(tph)
    hiP.push(tph)
    hiB.push(bar_index - tlRight)
    if hiP.size() > MAX_PIVOTS
        hiP.shift()
        hiB.shift()
if not na(tpl)
    loP.push(tpl)
    loB.push(bar_index - tlRight)
    if loP.size() > MAX_PIVOTS
        loP.shift()
        loB.shift()

// ── 52-week high / low ───────────────────────────────────────────────────
// Weekly bars: highest high / lowest low of the last 52 weeks, including the current week.
// lookahead_on is only read on the last bar (for drawing), where it is the live running value,
// so nothing from the future leaks in.
[hi52, lo52] = request.security(syminfo.tickerid, "W", [ta.highest(high, 52), ta.lowest(low, 52)],
     lookahead = barmerge.lookahead_on)

// ── Trend: 21-day linear regression (daily closes) ───────────────────────
// ta.linreg(close, n, 0) = the fitted line's value today; ta.linreg(close, n, n - 1) = its value at the
// start of the window. The % move between them is the regression trend over the window.
regPct(int n) =>
    float endV   = ta.linreg(close, n, 0)
    float startV = ta.linreg(close, n, n - 1)
    startV > 0 ? (endV / startV - 1) * 100 : na
regChg = request.security(syminfo.tickerid, "D", regPct(regLen))
regTrend = na(regChg) ? 0 : regChg > flatPct ? 1 : regChg < -flatPct ? -1 : 0

// ── 200 EMA and its 21-day slope (structure) ─────────────────────────────
emaSlope(int n, int w) =>
    float e      = ta.ema(close, n)
    float endV   = ta.linreg(e, w, 0)
    float startV = ta.linreg(e, w, w - 1)
    [e, startV > 0 ? (endV / startV - 1) * 100 : na]
[emaD, emaChg] = request.security(syminfo.tickerid, "D", emaSlope(emaLen, structLen))
structure = na(emaChg) ? 0 : emaChg > structFlat ? 1 : emaChg < -structFlat ? -1 : 0

// ── Trendline helpers ────────────────────────────────────────────────────
// True if any close between fromB and toB is on the wrong side of the line
lineBroken(float p1, int b1, float p2, int b2, int fromB, int toB, bool isUpper) =>
    bool broken = false
    if fromB <= toB
        float m = (p2 - p1) / (b2 - b1)
        for b = fromB to toB
            float y = p1 + m * (b - b1)
            float c = close[bar_index - b]
            if isUpper ? c > y : c < y
                broken := true
                break
    broken

// Most recent valid pair: newest anchor first, then the nearest earlier pivot
// that is higher (declining line) or lower (upward line) with no close through
// the line between the two anchors.
findLine(array<float> P, array<int> B, bool isUpper) =>
    int bi = -1
    int bj = -1
    int n  = P.size()
    if n >= 2
        for j = n - 1 to 1
            for i = j - 1 to 0
                bool shapeOk = isUpper ? P.get(i) > P.get(j) : P.get(i) < P.get(j)
                if shapeOk and not lineBroken(P.get(i), B.get(i), P.get(j), B.get(j), B.get(i) + 1, B.get(j) - 1, isUpper)
                    bi := i
                    bj := j
                    break
            if bi >= 0
                break
    [bi, bj]

// Returns [line, status]  status: -1 = no line found, 0 = intact, 1 = broken, -2 = not set (anchor too old)
drawTrend(array<float> P, array<int> B, bool isUpper, color c, bool show) =>
    line result = na
    int  status = -1
    [i, j] = findLine(P, B, isUpper)
    if i >= 0
        float p1 = P.get(i)
        int   b1 = B.get(i)
        float p2 = P.get(j)
        int   b2 = B.get(j)
        bool brokenSince = lineBroken(p1, b1, p2, b2, b2 + 1, bar_index, isUpper)
        float ageDays = (time - time[bar_index - b2]) / 86400000.0
        status := ageDays > setDays ? -2 : brokenSince ? 1 : 0
        if show and (not brokenSince or showBroken)
            result := line.new(b1, p1, b2, p2, extend = extend.right, width = tlWidth,
                 color = brokenSince ? color.new(c, 50) : c,
                 style = brokenSince ? line.style_dotted : line.style_solid)
    [result, status]

trendText(int v) => v > 0 ? "Up" : v < 0 ? "Down" : "Range"
trendCol(int v)  => v > 0 ? bullColor : v < 0 ? bearColor : color.gray
tlText(int s)    => s == 0 ? "Intact" : s == 1 ? "Broken" : "Not Set"

// ── Drawing (last bar only) ───────────────────────────────────────────────
var line  hi52Line = na
var line  lo52Line = na
var label hi52Lbl  = na
var label lo52Lbl  = na
var line  downTL = na
var line  upTL   = na
var table panel  = table.new(tablePos, 2, 6, bgcolor = color.new(chart.bg_color, 10),
     border_color = color.new(chart.fg_color, 80), border_width = 1,
     frame_color = color.new(chart.fg_color, 70), frame_width = 1)

if barstate.islast
    if not na(downTL)
        downTL.delete()
    if not na(upTL)
        upTL.delete()
    [dLine, dStatus] = drawTrend(hiP, hiB, true,  dnColor, showDown)
    [uLine, uStatus] = drawTrend(loP, loB, false, upColor, showUp)
    downTL := dLine
    upTL   := uLine

    line.delete(hi52Line)
    line.delete(lo52Line)
    label.delete(hi52Lbl)
    label.delete(lo52Lbl)
    if show52 and not na(hi52) and not na(lo52)
        hi52Line := line.new(bar_index - 1, hi52, bar_index, hi52, extend = extend.both,
             color = hi52Color, width = w52, style = line.style_solid)
        lo52Line := line.new(bar_index - 1, lo52, bar_index, lo52, extend = extend.both,
             color = lo52Color, width = w52, style = line.style_solid)
        if show52Lbl
            hi52Lbl := label.new(bar_index + 3, hi52, "52w high " + str.tostring(hi52, format.mintick) + "  (" +
                 str.tostring((close / hi52 - 1) * 100, "0.0") + "%)", style = label.style_label_left,
                 color = color.new(hi52Color, 80), textcolor = hi52Color, size = txtSize)
            lo52Lbl := label.new(bar_index + 3, lo52, "52w low " + str.tostring(lo52, format.mintick) + "  (+" +
                 str.tostring((close / lo52 - 1) * 100, "0.0") + "%)", style = label.style_label_left,
                 color = color.new(lo52Color, 80), textcolor = lo52Color, size = txtSize)

    if showPanel
        string overall = regTrend > 0 ? "Up" : regTrend < 0 ? "Down" : "Flat"

        color lbl = chart.fg_color
        table.cell(panel, 0, 0, "Trend (" + str.tostring(regLen) + "d regression)", text_color = lbl, text_size = txtSize)
        table.cell(panel, 1, 0, overall, text_color = color.white, bgcolor = trendCol(regTrend), text_size = txtSize)
        table.cell(panel, 0, 1, "Regression move", text_color = lbl, text_size = txtSize)
        table.cell(panel, 1, 1, na(regChg) ? "n/a" : str.tostring(regChg, "+0.0;-0.0") + "%",
             text_color = trendCol(regTrend), text_size = txtSize)
        int emaSide = na(emaD) ? 0 : close > emaD ? 1 : -1
        table.cell(panel, 0, 2, str.tostring(emaLen) + " EMA", text_color = lbl, text_size = txtSize)
        table.cell(panel, 1, 2, na(emaD) ? "n/a" : str.tostring(emaD, format.mintick) + "  (price " +
             str.tostring((close / emaD - 1) * 100, "+0.0;-0.0") + "%)", text_color = trendCol(emaSide), text_size = txtSize)
        table.cell(panel, 0, 3, "Structure (" + str.tostring(emaLen) + " EMA " + str.tostring(structLen) + "d slope)",
             text_color = lbl, text_size = txtSize)
        table.cell(panel, 1, 3, (structure > 0 ? "Up" : structure < 0 ? "Down" : "Flat") +
             (na(emaChg) ? "" : "  " + str.tostring(emaChg, "+0.00;-0.00") + "%"),
             text_color = trendCol(structure), text_size = txtSize)
        table.cell(panel, 0, 4, "Declining trendline", text_color = lbl, text_size = txtSize)
        table.cell(panel, 1, 4, tlText(dStatus),
             text_color = dStatus == 1 ? bullColor : dStatus == 0 ? dnColor : color.gray, text_size = txtSize)
        table.cell(panel, 0, 5, "Upward trendline", text_color = lbl, text_size = txtSize)
        table.cell(panel, 1, 5, tlText(uStatus),
             text_color = uStatus == 1 ? bearColor : uStatus == 0 ? upColor : color.gray, text_size = txtSize)
    else
        table.clear(panel, 0, 0, 1, 5)
